# NRI Investment Simplifier - Environment variables
# Copy this file to .env and fill in your own values. Never commit real secrets.

# Server
PORT=4000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# Database (PostgreSQL)
# Example: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/nri_investment_simplifier"

# JWT
JWT_ACCESS_SECRET=replace-with-a-strong-random-access-secret
JWT_REFRESH_SECRET=replace-with-a-strong-random-refresh-secret
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# Session / cookie
COOKIE_SECURE=false
COOKIE_SAME_SITE=Lax

# OpenAI (used by AI Regulatory Assistant)
# Leave empty to use the built-in mock assistant for the demo.
OPENAI_API_KEY=

# Rate limiting (requests per window per IP)
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# Admin seed
ADMIN_EMAIL=admin@nrisimplifier.local
ADMIN_PASSWORD=AdminChangeMe123!
