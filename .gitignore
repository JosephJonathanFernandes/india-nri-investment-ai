.idea/
.vscode/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Logs
logs
*.log
npm-debug.log*

# Testing
coverage/
.nyc_output/

# Prisma
prisma/migrations/*.lock

# Misc
.turbo/
.vercel
*.tsbuildinfo
